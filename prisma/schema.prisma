  level           Int      @unique @map("level")
  pointsRequired  Int      @default(0) @map("points_required")
  benefits        Json     @default("[]") @map("benefits")
  discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  color           String   @default("#6B7280") @map("color")
  icon            String?  @map("icon")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("membership_tiers")
}

model Membership {
  id            String    @id @default(uuid()) @map("id")
  userId        String    @unique @map("user_id")
  tierId        String    @map("tier_id")
  currentPoints Int       @default(0) @map("current_points")
  totalPoints   Int       @default(0) @map("total_points")
  dailyCheckinStreak Int  @default(0) @map("daily_checkin_streak")
  lastDailyCheckinAt DateTime? @map("last_daily_checkin_at")
  memberSince   DateTime  @default(now()) @map("member_since")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier MembershipTier @relation(fields: [tierId], references: [id])

  @@index([userId])
  @@map("memberships")
}

model PointsHistory {
  id          String       @id @default(uuid()) @map("id")
