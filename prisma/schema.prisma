// CiNect Cinema Platform - Prisma Schema
// PostgreSQL - Matches V1__init_schema.sql exactly
// Database: cinect_node via DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ ENUMS (matching SQL) ============
enum UserRole {
  ADMIN
  STAFF
  USER

  @@map("user_role")
}

enum MovieStatus {
  NOW_SHOWING
  COMING_SOON
  ENDED

  @@map("movie_status")
}

enum AgeRating {
  P
  C13
  C16
  C18

  @@map("age_rating")
}

enum RoomFormat {
  STANDARD2D @map("2D")
  STANDARD3D @map("3D")
  IMAX
  FOURDX     @map("4DX")
  DOLBY

  @@map("room_format")
}

enum SeatType {
  STANDARD
  VIP
  COUPLE
  DISABLED

  @@map("seat_type")
}

enum SeatStatus {
  AVAILABLE
  BOOKED
  BLOCKED

  @@map("seat_status")
}

enum TicketProductCode {
  ADULT_SINGLE
  CONCESSION_SINGLE
  ADULT_DOUBLE

  @@map("ticket_product_code")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED

  @@map("booking_status")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  CARD
  MOMO
  ZALOPAY
  VNPAY
  BANK_TRANSFER
  CASH

  @@map("payment_method")
}

enum DiscountType {
  PERCENTAGE
  FIXED

  @@map("discount_type")
}

enum PromotionStatus {
  ACTIVE
  INACTIVE
  EXPIRED

  @@map("promotion_status")
}

enum DayType {
  WEEKDAY
  WEEKEND
  HOLIDAY

  @@map("day_type")
}

enum TimeSlot {
  MORNING
  AFTERNOON
  EVENING
  NIGHT

  @@map("time_slot")
}

enum NotificationType {
  BOOKING
  PROMOTION
  SYSTEM
  MEMBERSHIP
  COMMUNITY
  REVIEW
  WATCHLIST
  REFUND

  @@map("notification_type")
}

enum CommunityPostType {
  DISCUSSION
  POLL

  @@map("community_post_type")
}

enum GiftCardStatus {
  AVAILABLE
  SOLD_OUT
  REDEEMED
  EXPIRED

  @@map("gift_card_status")
}

enum RefundMethod {
  STORE_CREDIT
  ORIGINAL_PAYMENT

  @@map("refund_method")
}

enum CouponStatus {
  ACTIVE
  USED
  EXPIRED

  @@map("coupon_status")
}

enum NewsCategory {
  REVIEWS
  TRAILERS
  PROMOTIONS
  GUIDES
  GENERAL

  @@map("news_category")
}

enum HoldStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONVERTED

  @@map("hold_status")
}

enum PointsTxType {
  EARNED
  SPENT
  EXPIRED
  ADJUSTED

  @@map("points_tx_type")
}

enum SupportCategory {
  BOOKING
  PAYMENT
  ACCOUNT
  TECHNICAL
  OTHER

  @@map("support_category")
}

// ============ MODELS ============
model Role {
  id          String   @id @default(uuid()) @map("id")
  name        UserRole @unique @map("name")
  permissions Json     @default("[]") @map("permissions")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles UserRoleJoin[]

  @@map("roles")
}

model User {
  id            String    @id @default(uuid()) @map("id")
  email         String    @unique @map("email")
  passwordHash  String?   @map("password_hash")
  fullName      String    @map("full_name")
  phone         String?   @map("phone")
  avatar        String?   @map("avatar")
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  gender        String?   @map("gender")
  city          String?   @map("city")
  provider      String?   @default("LOCAL") @map("provider")
  providerId    String?   @map("provider_id")
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified Boolean   @default(false) @map("email_verified")
  refreshToken  String?   @map("refresh_token")
  resetToken    String?   @map("reset_token")
  resetTokenExp DateTime? @map("reset_token_exp")
  referralCode  String    @unique @map("referral_code")
  referredById  String?   @map("referred_by_id")
  profilePublic Boolean   @default(true) @map("profile_public")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  userRoles         UserRoleJoin[]
  memberships       Membership[]
  pointsHistory     PointsHistory[]
  bookings          Booking[]
  holds             Hold[]
  reviews           Review[]
  reviewReactions   ReviewReaction[]
  notifications     Notification[]
  supportTickets    SupportTicket[]
  auditLogs         AuditLog[]
  couponAssignments Coupon[]
  giftRedemptions   GiftTransaction[] @relation("GiftRedemptions")
  bookingRefunds    BookingRefund[]
  watchlistItems    WatchlistItem[]
  communityPosts    CommunityPost[]
  communityPollVotes CommunityPollVote[]
  cinemaPhotos      CinemaPhoto[]
  groupInvitesHosted BookingGroupInvite[] @relation("GroupInviteHost")
  referredBy        User?               @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]              @relation("UserReferrals")
  referralsMade     Referral[]          @relation("Referrer")
  referralReceived  Referral?           @relation("Referred")

  @@unique([provider, providerId])
  @@index([email])
  @@index([city])
  @@index([referralCode])
  @@map("users")
}

model UserRoleJoin {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Genre {
  id   String @id @default(uuid()) @map("id")
  name String @unique @map("name")
  slug String @unique @map("slug")

  movieGenres MovieGenre[]

  @@map("genres")
}

model Movie {
  id            String      @id @default(uuid()) @map("id")
  title         String      @map("title")
  originalTitle String?     @map("original_title")
  slug          String      @unique @map("slug")
  description   String      @map("description")
  posterUrl     String      @map("poster_url")
  bannerUrl     String?     @map("banner_url")
  trailerUrl    String?     @map("trailer_url")
  galleryUrls   Json        @default("[]") @map("gallery_urls")
  duration      Int         @map("duration")
  releaseDate   DateTime    @map("release_date") @db.Date
  endDate       DateTime?   @map("end_date") @db.Date
  director      String      @map("director")
  castMembers   Json        @default("[]") @map("cast_members")
  language      String      @default("Vietnamese") @map("language")
  subtitles     String?     @map("subtitles")
  rating        Decimal     @default(0) @map("rating") @db.Decimal(3, 1)
  ratingCount   Int         @default(0) @map("rating_count")
  ageRating     AgeRating   @default(P) @map("age_rating")
  formats       Json        @default("[\"2D\"]") @map("formats")
  status        MovieStatus @default(COMING_SOON) @map("status")
  isDeleted     Boolean     @default(false) @map("is_deleted")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  movieGenres MovieGenre[]
  showtimes   Showtime[]
  reviews     Review[]
  watchlistItems WatchlistItem[]
  communityPosts CommunityPost[]
  cinemaPhotos   CinemaPhoto[]

  @@index([status])
  @@index([slug])
  @@index([releaseDate])
  @@map("movies")
}

model MovieGenre {
  movieId String @map("movie_id")
  genreId String @map("genre_id")

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@map("movie_genres")
}

/** 34 tỉnh/thành cấp một (sau sắp xếp 2025, tham chiếu Wikipedia / NQ 2025) */
model ProvinceNew {
  id        String   @id @default(uuid()) @map("id")
  code      String   @unique @map("code")
  nameVi    String   @map("name_vi")
  nameEn    String   @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  legacyUnits ProvinceLegacy[]
  cinemas     Cinema[]

  @@map("provinces_new")
}

/** 63 đơn vị cũ (trước sáp nhập), map sang ProvinceNew */
model ProvinceLegacy {
  id            String      @id @default(uuid()) @map("id")
  code          String      @unique @map("code")
  nameVi        String      @map("name_vi")
  nameEn        String      @map("name_en")
  provinceNewId String      @map("province_new_id")
  provinceNew   ProvinceNew @relation(fields: [provinceNewId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([provinceNewId])
  @@map("provinces_legacy")
}

model Cinema {
  id        String   @id @default(uuid()) @map("id")
  name      String   @map("name")
  slug      String   @unique @map("slug")
  address   String   @map("address")
  city      String   @map("city")
  ward      String?  @map("ward")
  district  String?  @map("district")
  phone     String?  @map("phone")
  email     String?  @map("email")
  imageUrl  String?  @map("image_url")
  amenities Json     @default("[]") @map("amenities")
  latitude  Float?   @map("latitude")
  longitude Float?   @map("longitude")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  provinceNewId String?      @map("province_new_id")
  provinceNew   ProvinceNew? @relation(fields: [provinceNewId], references: [id], onDelete: SetNull)

  rooms             Room[]
  showtimes         Showtime[]
  snacks            Snack[]
  pricingRules      PricingRule[]
  ticketPriceTiers  TicketPriceTier[]

  @@index([city])
  @@index([provinceNewId])
  @@map("cinemas")
}

model Room {
  id         String     @id @default(uuid()) @map("id")
  cinemaId   String     @map("cinema_id")
  name       String     @map("name")
  format     RoomFormat @default(STANDARD2D) @map("format")
  totalSeats Int        @default(0) @map("total_seats")
  rows            Int     @default(0) @map("rows")
  columns         Int     @default(0) @map("columns")
  layoutTemplate  String  @default("GRID") @map("layout_template")
  isActive        Boolean @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  cinema    Cinema     @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  seats     Seat[]
  showtimes Showtime[]

  @@unique([cinemaId, name])
  @@index([cinemaId])
  @@map("rooms")
}

model Seat {
  id       String     @id @default(uuid()) @map("id")
  roomId   String     @map("room_id")
  rowLabel String     @map("row_label")
  number   Int        @map("number")
  type     SeatType   @default(STANDARD) @map("type")
  status   SeatStatus @default(AVAILABLE) @map("status")
  pairId   String?  @map("pair_id")
  gridCol  Int?     @map("grid_col")
  isAisle  Boolean  @default(false) @map("is_aisle")
  price    Decimal? @map("price") @db.Decimal(12, 2)

  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  pair         Seat?         @relation("SeatPair", fields: [pairId], references: [id])
  pairedWith   Seat[]        @relation("SeatPair")
  holdSeats    HoldSeat[]
  bookingItems BookingItem[]

  @@unique([roomId, rowLabel, number])
  @@index([roomId])
  @@map("seats")
}

model Showtime {
  id              String     @id @default(uuid()) @map("id")
  movieId         String     @map("movie_id")
  roomId          String     @map("room_id")
  cinemaId        String     @map("cinema_id")
  startTime       DateTime   @map("start_time")
  endTime         DateTime   @map("end_time")
  basePrice       Decimal    @map("base_price") @db.Decimal(12, 2)
  format          RoomFormat @default(STANDARD2D) @map("format")
  language        String?    @map("language")
  subtitles       String?    @map("subtitles")
  isActive        Boolean    @default(true) @map("is_active")
  memberExclusive Boolean    @default(false) @map("member_exclusive")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  movie        Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  cinema       Cinema        @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  holds        Hold[]
  bookings     Booking[]
  holdSeats    HoldSeat[]
  bookingItems BookingItem[]

  @@index([movieId])
  @@index([cinemaId])
  @@index([roomId])
  @@index([startTime, endTime])
  @@map("showtimes")
}

model Hold {
  id         String     @id @default(uuid()) @map("id")
  userId     String     @map("user_id")
  showtimeId String     @map("showtime_id")
  seatIds    Json       @default("[]") @map("seat_ids")
  status     HoldStatus @default(ACTIVE) @map("status")
  expiresAt  DateTime   @map("expires_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  showtime  Showtime   @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  holdSeats      HoldSeat[]
  holdTicketLines HoldTicketLine[]
  bookings       Booking[]

  @@index([userId])
  @@index([showtimeId])
  @@index([expiresAt])
  @@map("holds")
}

model TicketProduct {
  id           String            @id @default(uuid()) @map("id")
  code         TicketProductCode @unique @map("code")
  labelVi      String            @map("label_vi")
  labelEn      String            @map("label_en")
  subLabelVi   String?           @map("sub_label_vi")
  subLabelEn   String?           @map("sub_label_en")
  seatsPerUnit Int               @default(1) @map("seats_per_unit")
  defaultPrice Decimal           @map("default_price") @db.Decimal(12, 2)
  sortOrder    Int               @default(0) @map("sort_order")
  isActive     Boolean           @default(true) @map("is_active")

  holdTicketLines HoldTicketLine[]

  @@map("ticket_products")
}

model HoldTicketLine {
  holdId      String            @map("hold_id")
  productCode TicketProductCode @map("product_code")
  quantity    Int               @map("quantity")
  unitPrice   Decimal           @map("unit_price") @db.Decimal(12, 2)

  hold    Hold          @relation(fields: [holdId], references: [id], onDelete: Cascade)
  product TicketProduct @relation(fields: [productCode], references: [code])

  @@id([holdId, productCode])
  @@map("hold_ticket_lines")
}

model HoldSeat {
  holdId     String @map("hold_id")
  showtimeId String @map("showtime_id")
  seatId     String @map("seat_id")

  hold     Hold     @relation(fields: [holdId], references: [id], onDelete: Cascade)
  showtime Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat     Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@id([holdId, seatId])
  @@unique([showtimeId, seatId])
  @@map("hold_seats")
}

model Booking {
  id             String        @id @default(uuid()) @map("id")
  userId         String        @map("user_id")
  showtimeId     String        @map("showtime_id")
  holdId         String?       @map("hold_id")
  totalAmount    Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalAmount    Decimal       @default(0) @map("final_amount") @db.Decimal(12, 2)
  status         BookingStatus @default(PENDING) @map("status")
  promotionCode  String?       @map("promotion_code")
  pointsUsed     Int           @default(0) @map("points_used")
  giftCardCode   String?       @map("gift_card_code")
  qrCode         String?       @map("qr_code")
  expiresAt      DateTime?     @map("expires_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user          User            @relation(fields: [userId], references: [id])
  showtime      Showtime        @relation(fields: [showtimeId], references: [id])
  hold          Hold?           @relation(fields: [holdId], references: [id])
  bookingItems  BookingItem[]
  bookingSnacks BookingSnack[]
  payments      Payment[]
  pointsHistory PointsHistory[]
  bookingRefund BookingRefund?
  groupInvite   BookingGroupInvite?
  cinemaPhotos  CinemaPhoto[]

  @@index([userId])
  @@index([showtimeId])
  @@index([status])
  @@map("bookings")
}

model BookingRefund {
  id               String       @id @default(uuid()) @map("id")
  bookingId        String       @unique @map("booking_id")
  userId           String       @map("user_id")
  amount           Decimal      @map("amount") @db.Decimal(12, 2)
  refundMethod     RefundMethod @map("refund_method")
  storeCreditCode  String?      @map("store_credit_code")
  pointsRestored   Int          @default(0) @map("points_restored")
  giftCardRestored String?      @map("gift_card_restored")
  reason           String?      @map("reason")
  createdAt        DateTime     @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("booking_refunds")
}

model BookingItem {
  id         String   @id @default(uuid()) @map("id")
  bookingId  String   @map("booking_id")
  seatId     String   @map("seat_id")
  showtimeId String   @map("showtime_id")
  rowLabel   String   @map("row_label")
  seatNumber Int      @map("seat_number")
  seatType   SeatType @map("seat_type")
  price      Decimal  @map("price") @db.Decimal(12, 2)

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat     Seat     @relation(fields: [seatId], references: [id])
  showtime Showtime @relation(fields: [showtimeId], references: [id])

  @@index([bookingId])
  @@index([showtimeId, seatId])
  @@map("booking_items")
}

model Snack {
  id          String   @id @default(uuid()) @map("id")
  cinemaId    String?  @map("cinema_id")
  name        String   @map("name")
  description String?  @map("description")
  price       Decimal  @map("price") @db.Decimal(12, 2)
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cinema        Cinema?        @relation(fields: [cinemaId], references: [id], onDelete: SetNull)
  bookingSnacks BookingSnack[]

  @@index([cinemaId])
  @@map("snacks")
}

model BookingSnack {
  id         String  @id @default(uuid()) @map("id")
  bookingId  String  @map("booking_id")
  snackId    String  @map("snack_id")
  name       String  @map("name")
  quantity   Int     @map("quantity")
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  snack   Snack   @relation(fields: [snackId], references: [id])

  @@index([bookingId])
  @@map("booking_snacks")
}

model Payment {
  id            String        @id @default(uuid()) @map("id")
  bookingId     String        @map("booking_id")
  method        PaymentMethod @map("method")
  amount        Decimal       @map("amount") @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING) @map("status")
  transactionId String?       @map("transaction_id")
  paymentUrl    String?       @map("payment_url")
  errorReason   String?       @map("error_reason")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([transactionId])
  @@map("payments")
}

model PricingRule {
  id        String      @id @default(uuid()) @map("id")
  name      String?     @map("name")
  cinemaId  String?     @map("cinema_id")
  seatType  SeatType?   @map("seat_type")
  format    RoomFormat? @map("format")
  dayType   DayType?    @map("day_type")
  timeSlot  TimeSlot?   @map("time_slot")
  isHoliday Boolean     @default(false) @map("is_holiday")
  price     Decimal     @map("price") @db.Decimal(12, 2)
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  cinema Cinema? @relation(fields: [cinemaId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@map("pricing_rules")
}

/** Display tiers for cinema detail "Bảng giá vé" (Cinestar-style table). */
model TicketPriceTier {
  id              String     @id @default(uuid()) @map("id")
  cinemaId        String?    @map("cinema_id")
  format          RoomFormat @map("format")
  categoryKey     String     @map("category_key")
  slotPrimary     String     @map("slot_primary")
  slotSecondary   String?    @map("slot_secondary")
  subtitle        String?    @map("subtitle")
  adultPrice      Decimal    @map("adult_price") @db.Decimal(12, 2)
  concessionPrice Decimal    @map("concession_price") @db.Decimal(12, 2)
  sortOrder       Int        @default(0) @map("sort_order")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  cinema Cinema? @relation(fields: [cinemaId], references: [id], onDelete: Cascade)

  @@index([cinemaId, format, isActive])
  @@map("ticket_price_tiers")
}

model Promotion {
  id            String          @id @default(uuid()) @map("id")
  title         String          @map("title")
  description   String?         @map("description")
  code          String?         @unique @map("code")
  discountType  DiscountType    @map("discount_type")
  discountValue Decimal         @map("discount_value") @db.Decimal(12, 2)
  minPurchase   Decimal?        @map("min_purchase") @db.Decimal(12, 2)
  maxDiscount   Decimal?        @map("max_discount") @db.Decimal(12, 2)
  usageLimit    Int?            @map("usage_limit")
  usageCount    Int             @default(0) @map("usage_count")
  startDate     DateTime        @map("start_date")
  endDate       DateTime        @map("end_date")
  imageUrl      String?         @map("image_url")
  conditions    String?         @map("conditions")
  status        PromotionStatus @default(ACTIVE) @map("status")
  isTrending    Boolean         @default(false) @map("is_trending")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  coupons Coupon[]

  @@index([status])
  @@index([startDate, endDate])
  @@map("promotions")
}

model Coupon {
  id            String       @id @default(uuid()) @map("id")
  userId        String?      @map("user_id")
  promotionId   String?      @map("promotion_id")
  code          String       @unique @map("code")
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(12, 2)
  minPurchase   Decimal?     @map("min_purchase") @db.Decimal(12, 2)
  maxDiscount   Decimal?     @map("max_discount") @db.Decimal(12, 2)
  status        CouponStatus @default(ACTIVE) @map("status")
  expiresAt     DateTime     @map("expires_at")
  usedAt        DateTime?    @map("used_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([code])
  @@map("coupons")
}

model MembershipTier {
  id              String   @id @default(uuid()) @map("id")
