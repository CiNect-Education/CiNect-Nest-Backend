# ============================================================
# CiNect NestJS Backend - Environment Variables
# ============================================================

# --- Database ---
# Runtime connection (Supabase or local PostgreSQL)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection for Prisma migrate/deploy
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Auth ---
JWT_SECRET=your-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256-algorithm
JWT_ACCESS_SECONDS=900
JWT_REFRESH_SECONDS=604800

# --- Server / CORS ---
PORT=3001
# Public base URL for uploaded files (avatar URLs). Defaults to http://localhost:PORT
PUBLIC_API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
DEFAULT_LOCALE=vi

# --- Email (Resend) ---
# Get API key: https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender in Resend dashboard, e.g. CiNect <noreply@yourdomain.com>
# Dev/testing without domain: CiNect <onboarding@resend.dev> (only sends to your Resend account email)
RESEND_FROM_EMAIL=CiNect <onboarding@resend.dev>
# Inbox for contact form submissions (defaults to cskh@cinect.com.vn)
SUPPORT_EMAIL=cskh@cinect.com.vn

# --- App Config ---
HOLD_TTL_MINUTES=10
PAYMENT_TIMEOUT_MINUTES=2
POINTS_PER_BOOKING=10
# Self-service ticket refund (aligned with FAQ: 2h before showtime)
REFUND_DEADLINE_HOURS=2
REFUND_MONTHLY_LIMIT=10
MAINTENANCE_MODE=false

# --- OpenAI (Support Chatbot) ---
# Required for POST /api/v1/support/chatbot
OPENAI_API_KEY=
# Optional; default gpt-4o-mini
OPENAI_CHATBOT_MODEL=gpt-4o-mini
# Dev only: fix "fetch failed" / UNABLE_TO_VERIFY_LEAF_SIGNATURE on Windows (antivirus SSL)
# OPENAI_INSECURE_TLS=true

# --- OAuth (Social Login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/v1/auth/facebook/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback
