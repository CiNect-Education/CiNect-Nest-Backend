# ============================================================
# CiNect NestJS Backend - Environment Variables
# ============================================================

# --- Database (Supabase PostgreSQL) ---
# Lấy từ Supabase Dashboard > Project Settings > Database
#
# DATABASE_URL  = Transaction Pooler (port 6543) - dùng cho app runtime
# DIRECT_URL    = Direct Connection (port 5432)  - dùng cho prisma migrate
#
# Format:
#   Pooler:  postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
#   Direct:  postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Hoặc dùng Local PostgreSQL ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cinect_node
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/cinect_node

# --- JWT ---
JWT_SECRET=your-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256-algorithm
JWT_ACCESS_SECONDS=900
JWT_REFRESH_SECONDS=604800

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Server ---
PORT=3001

# --- App Config ---
HOLD_TTL_MINUTES=10
PAYMENT_TIMEOUT_MINUTES=2
POINTS_PER_BOOKING=10
MAINTENANCE_MODE=false
